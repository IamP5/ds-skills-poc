      "primary": {
        "$type": "color",
        "$value": "{palette.blue.600}",
        "$description": "Fundo da ação principal"
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{palette.blue.700}",
        "$description": "Hover da ação principal"
      },
      "danger": {
        "$type": "color",
        "$value": "{palette.red.600}",
        "$description": "Ações destrutivas"
      }
    },
    "text": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.900}",
        "$description": "Texto corrido"
      },
      "subtle": {
        "$type": "color",
        "$value": "{palette.neutral.600}",
        "$description": "Texto de apoio"
      },
      "on-action": {
        "$type": "color",
        "$value": "{palette.neutral.0}",
        "$description": "Texto sobre color.action.*"
      }
    },
    "surface": {
      "default": {
        "$type": "color",
        "$value": "{palette.neutral.0}",
        "$description": "Fundo de página"
      },
      "raised": {
        "$type": "color",
        "$value": "{palette.neutral.50}",
        "$description": "Cards, sheets"
      }
    },
    "feedback": {
      "success": {
        "$type": "color",
        "$value": "{palette.green.600}",
        "$description": "Sucesso"
      },
      "error": {
        "$type": "color",
        "$value": "{palette.red.600}",
        "$description": "Erro de validação ou sistema"
      }
    }
  },
  "space": {
    "inset": {
      "sm": {
        "$type": "dimension",
        "$value": "{size.8}",
        "$description": "Padding interno pequeno"
      },
      "md": {
        "$type": "dimension",
        "$value": "{size.16}",
        "$description": "Padding interno padrão"
      }
    },
    "stack": {
      "md": {
        "$type": "dimension",
        "$value": "{size.16}",
        "$description": "Espaço vertical entre blocos"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{size.24}",
        "$description": "Espaço vertical entre seções"
      }
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{size.8}",
      "$description": "Inputs, botões"
    },
    "container": {
      "$type": "dimension",
      "$value": "{size.16}",
      "$description": "Cards, sheets, modais"
    }
  },
  "font": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "Arial",
          "sans-serif"
        ],
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "fontWeight": 700,
        "lineHeight": 1.25
      },
      "$description": "Títulos de tela e seção"
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "Arial",
          "sans-serif"
        ],
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "Texto corrido"
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": [
          "Inter",
          "Arial",
          "sans-serif"
        ],
        "fontSize": {
          "value": 14,
          "unit": "px"
        },
        "fontWeight": 600,
        "lineHeight": 1.25
