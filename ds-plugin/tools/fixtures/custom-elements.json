          "slots": [
            {
              "name": "",
              "description": "Rótulo"
            },
            {
              "name": "start",
              "description": "Ícone antes do rótulo (ds-icon)"
            },
            {
              "name": "end",
              "description": "Ícone depois do rótulo (ds-icon)"
            }
          ],
          "cssParts": [
            {
              "name": "native",
              "description": "O <button> interno"
            }
          ]
        }
      ]
    },
